<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Tea POS Automation Test Suite" verbose="2">
    <!-- =================================================================== -->
    <!-- BẮT SỰ KIỆN TESTLISTENER ĐỂ TỰ ĐỘNG CHỤP ẢNH MÀN HÌNH KHI TEST FAIL -->
    <!-- =================================================================== -->
    <listeners>
        <listener class-name="com.poly.sof309.ui.listeners.TestListener"/>
    </listeners>

    <!-- TEST SUITE 1: SMOKE TESTING (CÁC LUỒNG THEN CHỐT QUAN TRỌNG) -->
    <test name="Smoke Tests - Essential Flows">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.poly.sof309.ui.tests.LoginTestNGTest"/>
            <class name="com.poly.sof309.ui.tests.ProductTestNGTest"/>
        </classes>
    </test>

    <!-- TEST SUITE 2: REGRESSION & DATA-DRIVEN TESTING (CÁC LUỒNG NÂNG CAO) -->
    <test name="Regression Tests - Data Driven & Boundary">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.poly.sof309.ui.tests.LoginTestNGTest"/>
            <class name="com.poly.sof309.ui.tests.ProductTestNGTest"/>
        </classes>
    </test>
</suite>